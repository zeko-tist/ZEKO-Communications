# === Runtime Mode ===
# Set to True for English-only UPR (default for RPi5 deployment).
# Set to False to re-enable Malayalam/Manglish UPR and Sarvam TTS.
ENGLISH_ONLY=True

# === API Keys ===
GEMINI_API_KEY=your-key-here

# FROZEN: Sarvam API key — not required when ENGLISH_ONLY=True.
# SARVAM_API_KEY=your-sarvam-key-here

# === STT ===
# tiny.en recommended for RPi5 (39 MB, 2-3s). Upgrade to base.en/small.en for better accuracy.
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SAMPLE_RATE=16000

# === LLM (Online) ===
GEMINI_MODEL=gemini-2.5-flash

# === LLM (Offline) ===
# Gemma 3 1B Q4_K_M GGUF (~0.6 GB RAM — feasible on RPi5 CPU)
# Download: https://huggingface.co/bartowski/google_gemma-3-1b-it-GGUF
LOCAL_LLM_MODEL_PATH=models/gemma-3-1b-it-Q4_K_M.gguf
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_CTX_SIZE=1024

# === TTS — Online Primary (Gemini Flash TTS) ===
# Gemini TTS is now primary since Sarvam is frozen.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Pulcherrima

# === TTS — Offline (Kokoro) ===
KOKORO_LANG=en-us
KOKORO_VOICE=am_adam

# FROZEN: Sarvam TTS config — preserved for re-enablement.
# SARVAM_SPEAKER=shubh
# SARVAM_LANGUAGE=ml-IN
# SARVAM_MODEL=bulbul:v3

# === VAD ===
VAD_THRESHOLD=0.3
VAD_SILENCE_MS=700
VAD_MAX_SECONDS=15

# === Connectivity ===
CONNECTIVITY_CHECK_URL=https://generativelanguage.googleapis.com
CONNECTIVITY_TTL_SECONDS=5
